 email address","example":"user@example.com"},"username":{"type":"string","description":"Unique username","example":"john_doe"},"role":{"type":"string","description":"User role (USER or ADMIN)","example":"USER"},"createdAt":{"type":"string","description":"When the account was created","format":"date-time"}},"description":"The current user's account details"},"CreatorDashboardResponse":{"type":"object","properties":{"totalRaised":{"type":"number"},"totalWithdrawn":{"type":"number"},"availableBalance":{"type":"number"},"numberOfBackers":{"type":"integer","format":"int32"},"numberOfCampaigns":{"type":"integer","format":"int32"},"recentDonations":{"type":"array","items":{"$ref":"#/components/schemas/DonationSummary"}}}},"DonationSummary":{"type":"object","properties":{"date":{"type":"string","format":"date-time"},"amount":{"type":"number"}}},"AdminDashboardResponse":{"type":"object","properties":{"totalPlatformRaised":{"type":"number"},"totalFeesCollected":{"type":"number"},"totalCampaigns":{"type":"integer","format":"int64"},"totalUsers":{"type":"integer","format":"int64"},"topCampaigns":{"type":"array","items":{"$ref":"#/components/schemas/TopCampaign"}}}},"TopCampaign":{"type":"object","properties":{"id":{"type":"integer","format":"int64"},"title":{"type":"string"},"totalCollected":{"type":"number"}}}}}}